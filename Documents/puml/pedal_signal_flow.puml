@startuml
!theme blueprint
skinparam dpi 280
skinparam backgroundColor transparent
skinparam defaultFontName Microsoft YaHei UI
skinparam activityBorderColor black
skinparam arrowColor black
skinparam arrowFontColor black
skinparam activityDiamondBorderColor black
skinparam activityDiamondFontColor black
skinparam activityBarColor black
skinparam handwritten false
'title 踏板信号数据流

start
:物理踏板位置;
:霍尔传感器检测\n磁场强度 → 电压输出;
:ADC 采样\n12-bit (0-4095)\nGPIO35/32/33;
:电压校准\nesp_adc_cal_raw_to_voltage()\n输出: 0-3300mV;
:范围校准\n应用用户校准的 MIN/MAX 范围;
:死区处理\n消除两端 5% 抖动;
:映射转换\nmV → 0-255;
:EMA 滤波\n自适应平滑 α=0.2/0.7;
:步进限幅\n单次最大变化 ≤12;

partition "输出处理" {
  :延音踏板 (value 0-255);
  if (半踏模式?) then (是)
    :半踏判断\n在范围内: DAC 输出固定半踏电压\n不在范围: DAC 输出 value * 1.9V / 255;
  else (否)
    :DAC 输出 value * 1.9V / 255;
  endif
  
  :持音踏板 (value 0-255);
  if (蓝牙连接?) then (是)
    :禁用 DAC\n用于翻页;
  else (否)
    :DAC 输出 value * 1.9V / 255;
  endif
  
  :弱音踏板 (value 0-255);
  if (value > 127?) then (是)
    :GPIO17 HIGH (踩下);
  else (否)
    :GPIO17 LOW (松开);
  endif
}

stop

@enduml