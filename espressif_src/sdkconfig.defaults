# Piano Pedal Controller Default Configuration
# This file provides default values that can be overridden by the generated sdkconfig

# Power Management - Enable for lower power consumption
CONFIG_PM_ENABLE=y
CONFIG_PM_DFS_INIT_AUTO=y
CONFIG_PM_DEFAULT_SLEEP_MODE_LIGHT_SLEEP=y

# Task Watchdog Timer
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# Bluetooth Configuration (for BLE keyboard)
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BT_BLE_ENABLED=y

# WiFi Configuration
CONFIG_ESP32_WIFI_NVS_ENABLED=y

# Partition Table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partition.csv"

# ADC/DAC Configuration
CONFIG_ADC_DISABLE_DAC=n

# Logging Level
CONFIG_LOG_DEFAULT_LEVEL=4

# Build Optimization
CONFIG_COMPILER_OPTIMIZATION_LEVEL_RELEASE=y
